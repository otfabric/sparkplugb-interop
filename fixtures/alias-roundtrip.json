{
  "name": "alias-roundtrip",
  "description": "Verify aliases registered in BIRTH are used in DATA messages",
  "broker": "mosquitto",
  "steps": [
    {
      "action": "publish",
      "message": {
        "topic": "spBv1.0/testGroup/NBIRTH/testNode",
        "qos": 0,
        "retained": false,
        "payload": {
          "seq": 0,
          "metrics": [
            {"name": "bdSeq", "type": "UInt64", "value": 0},
            {"name": "temperature", "type": "Double", "value": 22.5, "alias": 1},
            {"name": "humidity", "type": "Float", "value": 55.0, "alias": 2}
          ]
        }
      }
    },
    {
      "action": "publish",
      "comment": "DATA uses aliases only — no name field",
      "message": {
        "topic": "spBv1.0/testGroup/NDATA/testNode",
        "qos": 0,
        "retained": false,
        "payload": {
          "seq": 1,
          "metrics": [
            {"alias": 1, "type": "Double", "value": 23.1},
            {"alias": 2, "type": "Float", "value": 56.2}
          ]
        }
      },
      "expect": {
        "resolvedNames": {
          "1": "temperature",
          "2": "humidity"
        }
      }
    }
  ]
}
