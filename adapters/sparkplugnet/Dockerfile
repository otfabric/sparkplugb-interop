# SparkplugNet interop adapter
#
# Builds a .NET container that runs SparkplugNet as an edge node or host
# application against the broker matrix. The entrypoint accepts a role
# flag (--edge or --host) and broker URL.
#
# Status: planned — not yet implemented.

# FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
# WORKDIR /src
# ... build SparkplugNet adapter ...
#
# FROM mcr.microsoft.com/dotnet/runtime:8.0
# COPY --from=build /src/out /app
# ENTRYPOINT ["/app/sparkplugnet-adapter"]
